+	getCTagName = xml.Name{calendarserverNamespace, "getctag"}
 )
 
+// calendarserverNamespace is the CalendarServer extension namespace, home of the
+// getctag property.
+const calendarserverNamespace = "http://calendarserver.org/ns/"
+
+// getCTag is the CalendarServer getctag property: an opaque token that changes
+// whenever anything in the calendar collection changes. Clients poll it to detect
+// updates cheaply, without walking every object.
+type getCTag struct {
+	XMLName xml.Name `xml:"http://calendarserver.org/ns/ getctag"`
+	CTag    string   `xml:",chardata"`
+}
+
